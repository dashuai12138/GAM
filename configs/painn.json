{
  "name": "3bpa_dense",
  "model": {
    "type": "dense",
    "backbone": "painn",
    "n_atom_basis": 128,
    "n_interactions": 3,
    "n_rbf": 20,
    "cutoff": 5.0
  },
  "data": {
    "format": "3bpa",
    "root": "reproduction_painn/datasets/3bpa/processed",
    "split_file": "reproduction_painn/datasets/3bpa/split_seed42.json",
    "test_domains": [
      "300K",
      "600K",
      "1200K",
      "dihedral"
    ],
    "neighbor_mode": "dynamic",
    "batch_size": 5,
    "sampling": "proportional",
    "num_workers": 0,
    "pin_memory": true,
    "fit_atomref": true
  },
  "training": {
    "epochs": 3000,
    "seed": 42,
    "learning_rate": 0.001,
    "stop_learning_rate": 1e-06,
    "decay_steps": 4500,
    "matmul_precision": "high",
    "fused_optimizer": true,
    "weight_decay": 0.0,
    "gradient_clip_norm": 10.0,
    "energy_weight": 1.0,
    "force_weight": 100.0,
    "validation_metric": "force_rmse",
    "primary_checkpoint_metric": "force",
    "early_stopping": false,
    "patience_epochs": 256,
    "validation_every_epochs": 1,
    "checkpoint_every_epochs": 10,
    "max_validation_structures": 50,
    "backbone_lr": 0.001
  },
  "output_dir": "reproduction_painn/runs/3bpa/dense_3000",
  "resolved_training": {
    "max_epochs": 3000,
    "steps_per_epoch": 90
  }
}